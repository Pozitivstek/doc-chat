# Ключ Claude API: https://console.anthropic.com/
# Без ключа приложение работает в режиме «поиск без LLM»: показывает найденные фрагменты со ссылками.
ANTHROPIC_API_KEY=

# Необязательно
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max
# CLAUDE_FALLBACKS=1          # 0 — отключить серверный фолбэк при отказе классификатора
# MAX_UPLOAD_MB=10
# MAX_PAGES=300
# TTL_HOURS=24                # через сколько часов документы удаляются
# COOKIE_SECURE=0             # 1 — за HTTPS
# HOST=127.0.0.1
# PORT=8000
# DB_PATH=data/docchat.db
